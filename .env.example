# Copy this file to .env and fill in your actual values
# cp .env.example .env

# Required. The app refuses to start without these two.
DATABASE_URL=postgresql://user:password@localhost:5432/jobtracker

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the example value — a shared signing key lets anyone forge a
# token for any account. Render generates this automatically in production.
SECRET_KEY=replace-me-with-a-generated-value

# Optional. Without a token the AI recommendation degrades but the app runs.
HF_API_TOKEN=hf_your_huggingface_api_token_here

# Optional. Defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173
